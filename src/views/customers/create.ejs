<!DOCTYPE html>
<html>
<head>
   <link rel="stylesheet" href="/css/createcustomer.css">
  <%- include('../partials/head', { pageTitle: 'New Customer' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPage: 'customers' }) %>
    <main class="main-content">
      <%- include('../partials/header', { pageTitle: 'New customer', user: user }) %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form action="/customers/create" method="POST" class="form-card">
        <div class="form-group">
          <label>Name</label>
          <input type="text" name="name" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Quantity bought</label>
            <input type="number" name="quantityBought" />
          </div>
          <div class="form-group">
            <label>Buying price</label>
            <input type="number" step="0.01" name="buyingPrice" />
          </div>
        </div>
        <div class="form-actions">
          <a href="/customers" class="btn">Cancel</a>
          <button type="submit" class="btn btn-primary">Create customer</button>
        </div>
      </form>
    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>