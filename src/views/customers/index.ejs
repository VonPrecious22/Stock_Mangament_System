<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/customer.css">
  <%- include('../partials/head', { pageTitle: 'Customers' }) %>
</head>

<body>
  <div class="app-layout">
    

    <%- include('../partials/sidebar', { currentPage: 'customers' }) %>

    <main class="main-content">

      <%- include('../partials/header', { pageTitle: 'Customers' }) %>

      <div class="detail-card">

        <div class="customer-list">

          <% if (customers && customers.length > 0) { %>

            <% customers.forEach(function(c) { %>

              <a href="/customers/<%= c._id %>" class="customer-row">

                <div class="customer-item">
                  <span class="detail-label">Customer</span>

                  <span class="detail-value">
                    <span class="customer-icon">
                      <i class="ti ti-user"></i>
                    </span>

                    <%= c.name %>
                  </span>
                </div>

                <div class="customer-item">
                  <span class="detail-label">Quantity Bought</span>

                  <span class="detail-value quantity">
                    <%= c.quantityBought || 0 %> units
                  </span>
                </div>

                <div class="customer-item">
                  <span class="detail-label">Buying Price</span>

                  <span class="detail-value price">
                    $<%= (c.buyingPrice || 0).toFixed(2) %>
                  </span>
                </div>

              </a>

            <% }); %>

          <% } else { %>

            <div class="empty-state">
              <p>No customers found.</p>
              <a href="/customers/create" class="btn btn-primary">
                + New customer
              </a>
            </div>

          <% } %>

        </div>

        <div class="detail-actions">
          <a href="/customers/create" class="btn btn-primary">
            + New customer
          </a>
        </div>

      </div>

    </main>
  </div>

  <%- include('../partials/footer') %>

</body>
</html>