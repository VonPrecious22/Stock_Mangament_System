<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { pageTitle: 'Edit Customer' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPage: 'customers' }) %>
    <main class="main-content">
      <%- include('../partials/header', { pageTitle: 'Edit customer' }) %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form action="/customers/<%= customer._id %>?_method=PUT" method="POST" class="form-card">
        <div class="form-group">
          <label>Name</label>
          <input type="text" name="name" value="<%= customer.name || '' %>" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Quantity bought</label>
            <input type="number" name="quantityBought" value="<%= customer.quantityBought || '' %>" />
          </div>
          <div class="form-group">
            <label>Buying price</label>
            <input type="number" step="0.01" name="buyingPrice" value="<%= customer.buyingPrice || '' %>" />
          </div>
        </div>
        <div class="form-actions">
          <a href="/customers/<%= customer._id %>" class="btn">Cancel</a>
          <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
      </form>
    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>