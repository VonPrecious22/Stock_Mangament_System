<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { pageTitle: customer.name }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPage: 'customers' }) %>
    <main class="main-content">
      <%- include('../partials/header', { pageTitle: customer.name }) %>

      <a href="/customers" class="back-link">&larr; Back to customers</a>

      <div class="detail-card">
        <p class="detail-title"><%= customer.name %></p>
        <p class="detail-description">Total bought: <%= customer.quantityBought || 0 %> units</p>
        <p class="detail-description">Buying price: $<%= (customer.buyingPrice || 0).toFixed(2) %></p>
      </div>

      <div class="detail-actions">
        <a href="/customers/<%= customer._id %>/edit" class="btn">Edit customer</a>
        <form action="/customers/<%= customer._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this customer?');">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>