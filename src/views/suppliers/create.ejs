<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head', { pageTitle: 'New Supplier' }) %>
<link rel="stylesheet" href="/css/createsupplier.css">
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPage: 'suppliers' }) %>
    <main class="main-content">
      <%- include('../partials/header', { pageTitle: 'New supplier', user: user }) %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form action="/suppliers/create" method="POST" class="form-card">
        <div class="form-group">
          <label>Name</label>
          <input type="text" name="name" required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Supply quantity</label>
            <input type="number" name="supplyQuantity" />
          </div>
          <div class="form-group">
            <label>Supply price</label>
            <input type="number" step="0.01" name="supplyPrice" required />
          </div>
        </div>
        <div class="form-group">
          <label>Contact</label>
          <input type="text" name="contact" />
        </div>
        <div class="form-group">
          <label>Address</label>
          <input type="text" name="address" />
        </div>
        <div class="form-actions">
          <a href="/suppliers" class="btn">Cancel</a>
          <button type="submit" class="btn btn-primary">Create supplier</button>
        </div>
      </form>
    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>