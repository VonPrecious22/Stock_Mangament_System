<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { pageTitle: 'New Supplier' }) %>
  <link rel="stylesheet" href="/css/createsupplier.css">
</head>

<body>

  <div class="app-layout">

    <%- include('../partials/sidebar', { currentPage: 'suppliers' }) %>

    <main class="main-content">

      <%- include('../partials/header', {
        pageTitle: 'New supplier',
        user: user
      }) %>


      <% if (typeof error !== 'undefined' && error) { %>

        <div class="form-error">
          <%= error %>
        </div>

      <% } %>


      <form
        action="/suppliers/create"
        method="POST"
        class="form-card"
      >

        <div class="form-group">

          <label for="name">
            Name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            placeholder="Enter supplier name"
            value="<%= typeof values !== 'undefined' ? values.name : '' %>"
            required
          />

        </div>


        <div class="form-group">

          <label for="contact">
            Contact
          </label>

          <input
            type="text"
            id="contact"
            name="contact"
            placeholder="Phone number or email"
            value="<%= typeof values !== 'undefined' ? values.contact : '' %>"
          />

        </div>


        <div class="form-group">

          <label for="address">
            Address
          </label>

          <input
            type="text"
            id="address"
            name="address"
            placeholder="Enter supplier address"
            value="<%= typeof values !== 'undefined' ? values.address : '' %>"
          />

        </div>


        <div class="form-group">

          <label>
            Supply information
          </label>

          <input
            type="text"
            value="Products and quantities are recorded when stock is received."
            readonly
          />

        </div>


        <div class="form-actions">

          <a
            href="/suppliers"
            class="btn"
          >
            Cancel
          </a>

          <button
            type="submit"
            class="btn btn-primary"
          >
            Create supplier
          </button>

        </div>

      </form>

    </main>

  </div>

  <%- include('../partials/footer') %>

</body>
</html>