<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/editsupplier.css">
  <%- include('../partials/head', { pageTitle: 'Edit Supplier' }) %>
</head>

<body>

  <div class="app-layout">

    <%- include('../partials/sidebar', { currentPage: 'suppliers' }) %>

    <main class="main-content">

      <%- include('../partials/header', {
        pageTitle: 'Edit supplier',
        user: user
      }) %>


      <% if (typeof error !== 'undefined' && error) { %>

        <div class="form-error">
          <%= error %>
        </div>

      <% } %>


      <form
        action="/suppliers/<%= supplier._id %>?_method=PUT"
        method="POST"
        class="form-card"
      >

        <div class="form-group">

          <label for="name">
            Name
          </label>

          <input
            type="text"
            id="name"
            name="name"
            value="<%= supplier.name || '' %>"
            required
          />

        </div>


        <div class="form-group">

          <label for="contact">
            Contact
          </label>

          <input
            type="text"
            id="contact"
            name="contact"
            value="<%= supplier.contact || '' %>"
          />

        </div>


        <div class="form-group">

          <label for="address">
            Address
          </label>

          <input
            type="text"
            id="address"
            name="address"
            value="<%= supplier.address || '' %>"
          />

        </div>


        <div class="form-group">

          <label>
            Supply information
          </label>

          <input
            type="text"
            value="Managed automatically from restock transactions"
            readonly
          />

        </div>


        <div class="form-actions">

          <a
            href="/suppliers/<%= supplier._id %>"
            class="btn"
          >
            Cancel
          </a>

          <button
            type="submit"
            class="btn btn-primary"
          >
            Save changes
          </button>

        </div>

      </form>

    </main>

  </div>

  <%- include('../partials/footer') %>

</body>
</html>