<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head', { pageTitle: 'Transactions' }) %>
  <link rel="stylesheet" href="/css/transaction.css">
</head>

<body>

  <div class="app-layout">

    <%- include('../partials/sidebar', { currentPage: 'transactions' }) %>

    <main class="main-content">

      <%- include('../partials/header', {
        pageTitle: 'Transactions',
        user: user
      }) %>


      <div class="transaction-list">

        <% if (transactions && transactions.length > 0) { %>

          <% transactions.forEach(function(transaction) { %>

            <div class="transaction-row">

              <!-- Date -->
              <div class="transaction-item">

                <span class="detail-label">
                  Date
                </span>

                <a
                  href="/transactions/<%= transaction._id %>"
                  class="transaction-date"
                >
                  <%= transaction.date
                    ? new Date(transaction.date).toDateString()
                    : 'No date'
                  %>
                </a>

              </div>


              <!-- Product -->
              <div class="transaction-item">

                <span class="detail-label">
                  Product
                </span>

                <span class="detail-value">
                  <%= transaction.product
                    ? transaction.product.name
                    : 'No product'
                  %>
                </span>

              </div>


              <!-- Customer / Supplier -->
              <div class="transaction-item">

                <span class="detail-label">
                  <%= transaction.type === 'sale'
                    ? 'Customer'
                    : 'Supplier'
                  %>
                </span>

                <span class="detail-value">

                  <% if (transaction.type === 'sale') { %>

                    <%= transaction.customer
                      ? transaction.customer.name
                      : 'No customer'
                    %>

                  <% } else { %>

                    <%= transaction.supplier
                      ? transaction.supplier.name
                      : 'No supplier'
                    %>

                  <% } %>

                </span>

              </div>


              <!-- Type -->
              <div class="transaction-item">

                <span class="detail-label">
                  Type
                </span>

                <span class="badge badge-<%= transaction.type %>">
                  <%= transaction.type %>
                </span>

              </div>


              <!-- Quantity -->
              <div class="transaction-item">

                <span class="detail-label">
                  Quantity
                </span>

                <span class="detail-value">
                  <%= transaction.quantityBought || 0 %>
                </span>

              </div>


              <!-- Amount -->
              <div class="transaction-item">

                <span class="detail-label">
                  Amount
                </span>

                <span class="detail-value amount">
                  <%= Number(transaction.amount || 0).toFixed(2) %>
                  FCFA
                </span>

              </div>


              <!-- Details -->
              <div class="transaction-item transaction-action">

                <a
                  href="/transactions/<%= transaction._id %>"
                  class="btn"
                >
                  View
                </a>

              </div>

            </div>

          <% }); %>


        <% } else { %>

          <div class="empty-state">

            <p>
              No transactions found.
            </p>

            <p>
              Transactions will appear automatically when you
              receive stock or make a sale.
            </p>

          </div>

        <% } %>

      </div>

    </main>

  </div>


  <%- include('../partials/footer') %>

</body>
</html>