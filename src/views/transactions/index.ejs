<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { pageTitle: 'Transactions' }) %>
  <link rel="stylesheet" href="/css/transaction.css">
</head>

<body>
  <div class="app-layout">

    <%- include('../partials/sidebar', { currentPage: 'transactions' }) %>

    <main class="main-content">

      <%- include('../partials/header', {
        pageTitle: 'Transactions',
        user: user
      }) %>


      <!-- =====================================================
           TRANSACTION LIST
           ===================================================== -->

      <div class="transaction-list">

        <% if (transactions && transactions.length > 0) { %>

          <% transactions.forEach(function(t) { %>

            <div class="transaction-row">

              <div class="transaction-item">
                <span class="detail-label">Date</span>

                <a
                  href="/transactions/<%= t._id %>"
                  class="transaction-date"
                >
                  <%= t.date.toDateString() %>
                </a>
              </div>


              <div class="transaction-item">
                <span class="detail-label">Customer</span>

                <span class="detail-value">
                  <%= t.customer ? t.customer.name : '—' %>
                </span>
              </div>


              <div class="transaction-item">
                <span class="detail-label">Type</span>

                <span class="badge badge-<%= t.type %>">
                  <%= t.type %>
                </span>
              </div>


              <div class="transaction-item">
                <span class="detail-label">Amount</span>

                <span class="detail-value amount">
                  $<%= t.amount.toFixed(2) %>
                </span>
              </div>


              <div class="transaction-item transaction-action">

                <form
                  action="/transactions/<%= t._id %>?_method=DELETE"
                  method="POST"
                  onsubmit="return confirm('Delete this transaction?');"
                >
                  <button
                    type="submit"
                    class="link-danger"
                  >
                    Delete
                  </button>
                </form>

              </div>

            </div>

          <% }); %>

        <% } else { %>

          <div class="empty-state">

            <p>No transactions found.</p>

          </div>

        <% } %>

      </div>


      <!-- =====================================================
           NEW TRANSACTION BUTTON
           ===================================================== -->

      <div class="page-actions">

        <a
          href="/transactions/create"
          class="btn btn-primary"
        >
          + New transaction
        </a>

      </div>

    </main>

  </div>

  <%- include('../partials/footer') %>

</body>
</html>