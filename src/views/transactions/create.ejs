<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head', { pageTitle: 'New Transaction' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPage: 'transactions' }) %>
    <main class="main-content">
      <%- include('../partials/header', { pageTitle: 'New transaction', user: user }) %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form action="/transactions/create" method="POST" class="form-card">
        <div class="form-group">
          <label>Customer</label>
          <select name="customerId">
            <option value="">No customer</option>
            <% customers.forEach(function(c) { %>
              <option value="<%= c._id %>"><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Type</label>
            <select name="type" required>
              <option value="sale">Sale</option>
              <option value="restock">Restock</option>
            </select>
          </div>
          <div class="form-group">
            <label>Amount</label>
            <input type="number" step="0.01" name="amount" required />
          </div>
        </div>
        <div class="form-group">
          <label>Quantity</label>
          <input type="number" name="quantityBought" />
        </div>
        <div class="form-group">
          <label>Notes</label>
          <textarea name="notes"></textarea>
        </div>
        <div class="form-actions">
          <a href="/transactions" class="btn">Cancel</a>
          <button type="submit" class="btn btn-primary">Create transaction</button>
        </div>
      </form>
    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>