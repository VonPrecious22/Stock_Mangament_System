<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head', { pageTitle: 'Reports' }) %>
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPage: 'reports' }) %>
    <main class="main-content">
      <%- include('../partials/header', { pageTitle: 'Financial summary', user: user }) %>

      <div class="stats-grid">
        <div class="stat-card">
          <p class="stat-label">Total revenue</p>
          <p class="stat-value stat-success">$<%= totalRevenue.toFixed(2) %></p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Total cost</p>
          <p class="stat-value stat-danger">$<%= totalCost.toFixed(2) %></p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Net profit</p>
          <p class="stat-value">$<%= profit.toFixed(2) %></p>
        </div>
        <div class="stat-card">
          <p class="stat-label">Inventory value</p>
          <p class="stat-value">$<%= inventoryValue.toFixed(2) %></p>
        </div>
      </div>
      <p class="hint-text">Revenue and cost are calculated from sale and restock transactions. Inventory value reflects current product quantity × selling price.</p>
    </main>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>