<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { pageTitle: 'Reports' }) %>
  <link rel="stylesheet" href="/css/report.css">
</head>

<body>

  <div class="app-layout">

    <%- include('../partials/sidebar', { currentPage: 'reports' }) %>

    <main class="main-content">

      <%- include('../partials/header', {
        pageTitle: 'Financial summary',
        user: user
      }) %>


      <div class="stats-grid">

        <!-- Total Revenue -->
        <div class="stat-card">

          <span class="stat-label">
            Total revenue
          </span>

          <span class="stat-value stat-success">
            <%= (totalRevenue || 0).toFixed(1) %> FCFA
          </span>

        </div>


        <!-- Total Cost -->
        <div class="stat-card">

          <span class="stat-label">
            Total cost
          </span>

          <span class="stat-value stat-danger">
            <%= (totalCost || 0).toFixed(1) %> FCFA
          </span>

        </div>


        <!-- Net Profit -->
        <div class="stat-card">

          <span class="stat-label">
            Net profit
          </span>

          <span class="stat-value">
            <%= (profit || 0).toFixed(1) %> FCFA
          </span>

        </div>


        <!-- Inventory Value -->
        <div class="stat-card">

          <span class="stat-label">
            Inventory value
          </span>

          <span class="stat-value">
            <%= (inventoryValue || 0).toFixed(1) %> FCFA
          </span>

        </div>

      </div>


      <p class="hint-text">
        This is an overall summary of your stock and financial activity.
      </p>


    </main>

  </div>


  <%- include('../partials/footer') %>

</body>
</html>