<aside class="sidebar">
  <div class="sidebar-brand">
    <h2>Stock Manager</h2>
  </div>

  <nav class="sidebar-nav" aria-label="Main navigation">
    <a
      href="/dashboard"
      class="nav-tile <%= currentPage === 'dashboard' ? 'active' : '' %>"
    >
      <span class="nav-icon">⌂</span>
      <span>Dashboard</span>
    </a>

    <a
      href="/stocks"
      class="nav-tile <%= currentPage === 'stocks' ? 'active' : '' %>"
    >
      <span class="nav-icon">▤</span>
      <span>Stock</span>
    </a>

    <a
      href="/products"
      class="nav-tile <%= currentPage === 'products' ? 'active' : '' %>"
    >
      <span class="nav-icon">▣</span>
      <span>Products</span>
    </a>

    <a
      href="/suppliers"
      class="nav-tile <%= currentPage === 'suppliers' ? 'active' : '' %>"
    >
      <span class="nav-icon">♙</span>
      <span>Suppliers</span>
    </a>

    <a
      href="/customers"
      class="nav-tile <%= currentPage === 'customers' ? 'active' : '' %>"
    >
      <span class="nav-icon">♧</span>
      <span>Customers</span>
    </a>

    <a
      href="/transactions"
      class="nav-tile <%= currentPage === 'transactions' ? 'active' : '' %>"
    >
      <span class="nav-icon">↔</span>
      <span>Transactions</span>
    </a>

    <a
      href="/reports"
      class="nav-tile <%= currentPage === 'reports' ? 'active' : '' %>"
    >
      <span class="nav-icon">▥</span>
      <span>Reports</span>
    </a>
  </nav>

<div class="sidebar-footer">
  <form action="/logout" method="POST" class="logout-form">
    <button type="submit" class="logout-tile">
      <span class="nav-icon">
        <i class="ti ti-logout"></i>
      </span>
      <span>Logout</span>
    </button>
  </form>
</div>
</aside>




 