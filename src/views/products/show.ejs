<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/showproduct.css">
  <%- include('../partials/head', { pageTitle: product.name }) %>
</head>

<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', { currentPage: 'products' }) %>

    <main class="main-content">
  <%- include('../partials/header', {
        pageTitle: 'Products',
        user: user
      }) %>


      <a href="/products" class="back-link">&larr; Back to products</a>

      <div class="detail-card">

        <!-- Product information -->
        <div class="product-info">
          <div class="detail-item">
            <span class="detail-label">Product</span>
            <span class="detail-value"><%= product.name %></span>
          </div>

          <div class="detail-item">
            <span class="detail-label">Selling price</span>
            <span class="detail-value">
              $<%= Number(product.sellingPrice || 0).toFixed(2) %>
            </span>
          </div>

          <div class="detail-item">
            <span class="detail-label">Quantity</span>
            <span class="detail-value">
              <%= product.quantity || 0 %>
            </span>
          </div>

          <div class="detail-item">
            <span class="detail-label">Value tier</span>
            <span class="detail-value">
              Tier <%= product.category || '—' %>
            </span>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="detail-actions">
          <a href="/products/<%= product._id %>/edit" class="btn btn-edit">
            Edit product
          </a>

          <form
            action="/products/<%= product._id %>?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Delete this product?');"
          >
            <button type="submit" class="btn btn-danger">
              Delete
            </button>
          </form>
        </div>

      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>