<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <%- include('../partials/head', {
    pageTitle: stock.name
  }) %>

  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/stockdetails.css">

</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar', {
      currentPage: 'stocks'
    }) %>
    <main class="main-content">
      <a
        href="/stocks"
        class="back-link"
      >
        &larr; Back to stock
      </a>

      <div class="detail-card">

        <div class="detail-card-top">

          <div>

            <p class="detail-title">
              <%= stock.name %>
            </p>

            <p class="detail-subtitle">

              Created

              <%= (
                stock.date ||
                stock.createdAt ||
                new Date()
              ).toDateString() %>
            </p>
          </div>
          <span
            class="badge badge-<%= stock.valuationMethod.toLowerCase() %>"
          >
            <%= stock.valuationMethod %>
          </span>

        </div>
        <div class="stock-details-grid">

          <div>
            <strong>Quantity</strong>
            <p><%= stock.quantity %> units</p>
          </div>


          <div>
            <strong>Cost per unit</strong>
            <p><%= stock.costPerUnit %> FCFA</p>
          </div>


          <div>
            <strong>Total cost</strong>
            <p>
              <%= stock.quantity * stock.costPerUnit %> FCFA
            </p>
          </div>


          <div>
            <strong>Supplier</strong>

            <p>
              <%= stock.supplier
                ? stock.supplier.name
                : '—'
              %>
            </p>

        <p class="detail-description">

          <%= stock.description || 'No description' %>

        </p>

          </div>
 
        </div>

      </div>


      <!-- Product -->

      <p class="section-title">
        Product in this batch
      </p>


      <% if (stock.product) { %>

        <div class="product-row-card">

          <div class="product-icon">
            <i class="ti ti-package"></i>
          </div>


          <div>

            <p class="product-name">
              <%= stock.product.name %>
            </p>


            <p class="product-meta">

              <%= stock.product.sellingPrice %> FCFA

              · Category
              <%= stock.product.category || '—' %>

              · Current stock
              <%= stock.product.quantity %> units

            </p>

          </div>

        </div>


      <% } else { %>

        <p>
          No product linked to this batch.
        </p>

      <% } %>


      <!-- Actions -->

      <div class="detail-actions">

        <a
          href="/stocks/<%= stock._id %>/edit"
          class="btn btn-edit"
        >
          Edit batch
        </a>

      </div>

    </main>

  </div>


  <%- include('../partials/footer') %>

</body>

</html>