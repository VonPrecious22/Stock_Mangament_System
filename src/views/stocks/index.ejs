<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <%- include('../partials/head', { pageTitle: 'Stock' }) %>

  <link rel="stylesheet" href="/css/sidebar.css">
  <link rel="stylesheet" href="/css/stock.css">

</head>

<body>

  <div class="app-layout">

    <%- include('../partials/sidebar', {
      currentPage: 'stocks'
    }) %>


    <main class="main-content">

      <%- include('../partials/header', {
        pageTitle: 'Stock Overview',
        user: user
      }) %>


      <section class="page-section">

        <div class="page-heading">

          <div>

            <h1 class="page-title">
              Stock Overview
            </h1>

            <p class="page-description">
              View and manage your stock batches.
            </p>

          </div>

        </div>


        <div class="table-container">

          <table class="data-table">

            <thead>

              <tr>

                <th>Batch</th>

                <th>Product</th>

                <th>Supplier</th>

                <th>Quantity</th>

                <th>Cost / Unit</th>

                <th>Method</th>

                <th>Actions</th>

              </tr>

            </thead>


            <tbody>

              <% if (stocks && stocks.length > 0) { %>

                <% stocks.forEach(function(s) { %>

                  <tr>

                    <!-- Batch -->

                    <td>

                      <a
                        href="/stocks/<%= s._id %>"
                        class="batch-link"
                      >
                        <%= s.name || 'Unnamed batch' %>
                      </a>

                    </td>


                    <!-- Product -->

                    <td>

                      <%= s.product
                        ? s.product.name
                        : '—'
                      %>

                    </td>


                    <!-- Supplier -->

                    <td>

                      <%= s.supplier
                        ? s.supplier.name
                        : '—'
                      %>

                    </td>


                    <!-- Batch quantity -->

                    <td>

                      <%= s.quantity || 0 %>

                    </td>


                    <!-- Cost -->

                    <td>

                      <%= s.costPerUnit || 0 %> FCFA

                    </td>


                    <!-- Valuation method -->

                    <td>

                      <% let badgeClass = 'badge-default'; %>

                      <% if (s.valuationMethod) { %>

                        <% if (s.valuationMethod === 'FIFO') { %>

                          <% badgeClass = 'badge-fifo'; %>

                        <% } else if (s.valuationMethod === 'LIFO') { %>

                          <% badgeClass = 'badge-lifo'; %>

                        <% } %>

                      <% } %>


                      <span class="badge <%= badgeClass %>">

                        <%= s.valuationMethod || 'N/A' %>

                      </span>

                    </td>


                    <!-- Actions -->

                    <td>

                      <div class="action-buttons">

                        <a
                          href="/stocks/<%= s._id %>"
                          class="btn btn-edit"
                        >
                          View
                        </a>

                        <a
                          href="/stocks/<%= s._id %>/edit"
                          class="btn btn-edit"
                        >
                          Edit
                        </a>

                      </div>

                    </td>

                  </tr>

                <% }); %>


              <% } else { %>

                <tr>

                  <td
                    colspan="7"
                    class="empty-message"
                  >
                    No stock batches found.
                  </td>

                </tr>

              <% } %>

            </tbody>

          </table>

        </div>


        <!-- New stock -->

        <div class="bottom-actions">

          <a
            href="/stocks/create"
            class="btn btn-primary"
          >
            + Receive Stock
          </a>

        </div>

      </section>

    </main>

  </div>


  <%- include('../partials/footer') %>

</body>

</html>