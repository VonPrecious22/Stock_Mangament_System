<!DOCTYPE html>
<html>
<head>
  <%- include('../partials/head', { pageTitle: 'Login' }) %>
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <p class="auth-title">Stock Manager</p>
      <p class="auth-subtitle">Log in to your account</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <form action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="btn btn-primary" style="width:80%;">Log in</button>
      </form>

      <p class="auth-switch">Don't have an account? <a href="/register">Register</a></p>
    </div>
  </div>
</body>
</html>